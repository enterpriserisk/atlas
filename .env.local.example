# Copy this file to .env.local (already gitignored) and fill in real values.

# The AI Task Advisor uses this to call Groq — get a free key at
# https://console.groq.com/keys. No credit card needed for the free tier.
GROQ_API_KEY=
# Optional: override the preferred model. Groq periodically deprecates models with notice
# (see https://console.groq.com/docs/deprecations) — src/lib/advisor/groq.ts falls back to
# a small chain of other models automatically if this one becomes unavailable, so a
# deprecation degrades gracefully instead of breaking the Advisor outright. Still worth
# updating this (and the fallback list in that file) when Groq announces one.
GROQ_MODEL=openai/gpt-oss-120b

# Dynamic content (Playbook submissions, Resource Directory) is stored in Postgres via
# Neon's serverless driver — sign up free at https://neon.tech, create a project, and
# paste the connection string it gives you here.
DATABASE_URL=

# The password for /admin, where you generate and revoke contributor access keys. Make up
# a long random string — anyone with this can generate keys, so keep it secret.
ADMIN_SECRET=

# Random secret used to sign session cookies (admin login + contributor access-key
# unlocks). Make up a long random string; it doesn't need to be memorable, just secret and
# unique to this deployment.
SESSION_SECRET=
